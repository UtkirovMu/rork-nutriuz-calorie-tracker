{
  "expo": {
    "name": "Oqsil",
    "slug": "oqsil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.sol36n6dvpnukxkwe9729"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.sol36n6dvpnukxkwe9729"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "react-native-health",
        {
          "healthSharePermission": "Sizning qadamlar, yurak urishi va kaloriya ma'lumotlaringiz tahlil uchun kerak.",
          "healthUpdatePermission": "Ilova sog'liq ma'lumotlaringizni yangilaydi.",
          "isClinicalDataEnabled": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
